plugin.tx_feusernewslettersubscription {
    view {
        templateRootPaths {
            0 = EXT:feuser_newsletter_subscription/Resources/Private/Templates/
            1 = {$plugin.tx_feusernewslettersubscription.view.templateRootPath}
        }

        partialRootPaths {
            0 = EXT:feuser_newsletter_subscription/Resources/Private/Partials/
            1 = {$plugin.tx_feusernewslettersubscription.view.partialRootPath}
        }

        layoutRootPaths {
        0 = EXT:feuser_newsletter_subscription/Resources/Private/Layouts/
        1 = {$plugin.tx_feusernewslettersubscription.view.layoutRootPath}
        }
    }

    persistence {
        storagePid = {$plugin.tx_feusernewslettersubscription.persistence.storagePid}
    }
}

# Compatibility for existing content elements using the former CType.
tt_content.list.20.feuser_newsletter_subscription_subscribe = EXTBASEPLUGIN
tt_content.list.20.feuser_newsletter_subscription_subscribe {
    extensionName = FeuserNewsletterSubscription
    pluginName = Subscribe
}
tt_content.feuser_newsletter_subscription_subscribe < tt_content.list.20.feuser_newsletter_subscription_subscribe

tt_content.list.20.feuser_newsletter_subscription_unsubscribe = EXTBASEPLUGIN
tt_content.list.20.feuser_newsletter_subscription_unsubscribe {
    extensionName = FeuserNewsletterSubscription
    pluginName = Unsubscribe
}
tt_content.feuser_newsletter_subscription_unsubscribe < tt_content.list.20.feuser_newsletter_subscription_unsubscribe
